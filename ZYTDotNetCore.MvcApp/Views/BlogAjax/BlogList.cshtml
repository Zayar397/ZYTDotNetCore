@model List<TblBlog>

<a href="/BlogAjax/Create" class="btn btn-outline-primary">New</a>

<table class="table">
	<thead>
		<tr>
			<th></th>
			<th>No.</th>
			<th>Title</th>
			<th>Author</th>
			<th>Content</th>
		</tr>
	</thead>
	<tbody id="tbDataTable">
	</tbody>
</table>

@section Scripts{
	<script>
			$(document).ready(function(){
				loadData();
		});

		function loadData()
		{
			$.ajax({
							url: "/BlogAjax/List",
							type: "GET",
							success: function(response){
								console.log({response});

								$('#tbDataTable').html('');
								for(let i = 0; i < response.length; i++)
								{
									let blogItem = response[i];
									let tr = `<tr>
												<td>
													<a href="/BlogAjax/Edit/${blogItem.BlogId}" class="btn btn-primary">Edit</a>
													<button type="button" data-id = "${blogItem.BlogId}" class="btn btn-primary btnDelete">Delete</a>
												</td>
												<td>${i + 1}</td>
												<td>${blogItem.BlogTitle}</td>
												<td>${blogItem.BlogAuthor}</td>
												<td>${blogItem.BlogContent}</td>
											</tr>`;
									$('#tbDataTable').append(tr);
								}
								bindDeleteBtn();
							},
							error: function(error){
								console.log(error);
							}
				});
		}

		function bindDeleteBtn()
		{
			$('.btnDelete').click(function(){
				const id = $(this).data('id');
				$.ajax({
							url: "/BlogAjax/Delete",
							type: "POST",
							data: {
								Id: id
							},
							success: function(response){
								console.log({response});
								if(!response.IsSuccess)
								{
									alert(response.Message);
									return;
								}

								alert(response.Message);
								location.href = "/BlogAjax";

							},
							error: function(error){
								console.log(error);
							}
				});
			});
		}
	</script>
}