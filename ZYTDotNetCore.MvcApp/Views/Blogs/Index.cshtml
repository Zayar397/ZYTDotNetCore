@model List<TblBlog>

@{
	bool isShowMessage = TempData["IsSuccess"] != null;
	bool isSuccess = false;
	string message = "";
	if (isShowMessage)
	{
		isSuccess = Convert.ToBoolean(TempData["IsSuccess"]);
		message = Convert.ToString(TempData["Message"]);
	}
}

@if (isShowMessage)
{
	if (isSuccess)
	{
		<div class="alert alert-primary mb-2" role="alert">
			@message
		</div>
	}
	else
	{
		<div class="alert alert-danger mb-2" role="alert">
			@message
		</div>
	}
}

<a href="/Blogs/Create" class="btn btn-outline-primary">New</a>

<table class="table">
	<thead>
		<tr>
			<th></th>
			<th>No.</th>
			<th>Title</th>
			<th>Author</th>
			<th>Content</th>
		</tr>
	</thead>
	<tbody>
		@for(int i = 0; i<Model.Count; i++)
		{
			var item = Model[i];
			<tr>
				<td>
					<a href="/Blogs/Edit/@(item.BlogId)" class="btn btn-primary">Edit</a>
					<a href="/Blogs/Delete/@(item.BlogId)" class="btn btn-primary">Delete</a>
				</td>
				<td>@(i + 1)</td>
				<td>@item.BlogTitle</td>
				<td>@item.BlogAuthor</td>
				<td>@item.BlogContent</td>
			</tr>
		}
	</tbody>
</table>
